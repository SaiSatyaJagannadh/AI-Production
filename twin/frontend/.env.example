# Base URL of the twin backend — NO trailing /chat needed (it is appended).
#
# Local:  http://localhost:8000
# Deployed: the API Gateway "Invoke URL" from week2/day2.md Part 6, e.g.
#   https://abc123xyz.execute-api.us-east-1.amazonaws.com
#
# NEXT_PUBLIC_* is inlined at BUILD time. After changing this you must rebuild
# and re-upload:  npm run build && aws s3 sync out/ s3://YOUR-BUCKET/ --delete
NEXT_PUBLIC_API_URL=http://localhost:8000
